# ==============================================================================
# Sandcastle Orchestrator Environment Configuration
# ==============================================================================

# Authentication:
# The host Google Antigravity OAuth session is bridged automatically from
# Windows Credential Manager (gemini:antigravity). No API key is required.
# Ensure you are logged in on the host by running `agy` before orchestration.

# GitHub Personal Access Token — used by agents to read, triage, and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=

# ------------------------------------------------------------------------------
# Phase-Scoped Agent Model Configuration
# ------------------------------------------------------------------------------
# Global default model fallback across all phases (defaults to gemini-3.8-flash-high if unset)
AGENT_MODEL=gemini-3.8-flash-high

# Phase 1 (Plan): Planning agent — analyzes open issues, builds dependency graph, outputs structured plan
PLANNER_MODEL=gemini-4-argon-high

# Phase 2 (Implement): Implementation agent — test-driven development, code modifications, and Maven test cycles
IMPLEMENTER_MODEL=gemini-3.8-flash-high

# Phase 3 (Review): Reviewer agent — git diff inspection against CODING_STANDARDS.md and issue specifications
REVIEWER_MODEL=gemini-3.8-flash-medium

# Phase 4 (Merge): Merger agent — multi-branch integration, conflict resolution, and merge commit creation
MERGER_MODEL=gemini-4-argon-high

# ------------------------------------------------------------------------------
# Base Branch Configuration
# ------------------------------------------------------------------------------
# Base branch for Sandcastle agent worktrees, diff comparisons, and PRs.
# Commits are strictly restricted to refractor/ai-main-implementation and its child branches.
# Protected branches (main, homol, developer) must NEVER be altered.
BASE_BRANCH=refractor/ai-main-implementation
